{
  "_comment": "Vocabulary used only by value.py. Which rows are SaaS, which are subtotals and what counts as a repeat live in pipeline/shared.json, shared with ask/.",
  "pnl_file_glob": "pnl_*.csv",
  "category_column": "Category",
  "label_column": "Line Item",
  "notes_column": "Notes",
  "amount_column_pattern": "^(?P<period>Q[1-4]_[0-9]{4})_(?P<currency>[A-Z]{3})$",
  "suspicion_terms": [
    "twice",
    "double",
    "duplicate",
    "same product",
    "one contract"
  ],
  "renewal_terms": [
    "renew"
  ],
  "caveat_terms": [
    "illustrative",
    "pre-close"
  ],
  "export_date_pattern": "Export generated\\s+[0-9]{4}-[0-9]{2}-[0-9]{2}",
  "closing_document_terms": [
    "invoice",
    "contract",
    "ledger",
    "statement",
    "payment"
  ],
  "periods_per_year": 4,
  "period_unit": "quarter"
}
